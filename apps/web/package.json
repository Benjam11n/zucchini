{
  "name": "@zucchini/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run typecheck && vite build",
    "audit": "pnpm audit",
    "audit:ci": "pnpm audit --prod --audit-level high",
    "typecheck": "tsgo -p tsconfig.json --noEmit",
    "react-doctor": "npx -y react-doctor@0.9.18 . --verbose --diff"
  },
  "dependencies": {
    "lucide-react": "1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": "24.x"
  }
}
