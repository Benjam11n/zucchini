{
  "name": "@zucchini/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run typecheck && vite build",
    "audit": "pnpm audit",
    "audit:ci": "pnpm audit --prod --audit-level high",
    "typecheck": "tsgo -p tsconfig.json --noEmit",
    "react-doctor": "npx -y react-doctor@latest . --verbose --diff"
  },
  "dependencies": {
    "lucide-react": "1.34.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.5",
    "@types/three": "^0.185.4",
    "@typescript/native-preview": "^7.0.0-dev.20260526.1",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  },
  "engines": {
    "node": "24.x"
  }
}
