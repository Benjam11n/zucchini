{
  "name": "zucchini",
  "version": "0.1.2-beta.15",
  "private": true,
  "description": "Local-first habit tracker.",
  "author": "Benjamin Wang",
  "main": "dist-electron/main.js",
  "scripts": {
    "assets:process": "tsx scripts/process-mascots.ts",
    "db:generate": "drizzle-kit generate",
    "rebuild:native": "node scripts/install-native-deps.mjs",
    "dev": "concurrently -k \"pnpm run dev:renderer\" \"pnpm run dev:bundle\" \"pnpm run dev:electron\"",
    "dev:renderer": "vite",
    "dev:bundle": "tsdown --watch",
    "dev:electron": "node scripts/dev-electron.mjs",
    "start": "pnpm run build && node scripts/start-electron.mjs",
    "build": "pnpm run typecheck && vite build && tsdown",
    "dist:desktop": "pnpm run build && electron-builder --config electron-builder.config.ts",
    "dist:release:win": "electron-builder --config electron-builder.config.ts --win nsis --publish always",
    "dist:release:mac": "electron-builder --config electron-builder.config.ts --mac dmg zip --publish always",
    "testdata:generate": "electron -r tsx/cjs scripts/generate-test-data.ts",
    "typecheck": "tsgo -p tsconfig.json --noEmit",
    "audit": "pnpm audit",
    "audit:ci": "pnpm audit --prod --audit-level high",
    "test": "vitest run",
    "react-doctor": "npx -y react-doctor@0.9.18 . --verbose --diff"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@fiahfy/icns": "^0.0.7",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-form": "^1.33.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "electron": "45.0.0",
    "electron-builder": "^26.18.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^14.6.0",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.61.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.66.0",
    "png-to-ico": "^3.0.2",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.22.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.23.2",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "ultracite": "^7.7.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "optionalDependencies": {
    "macos-notification-state": "^3.0.0",
    "windows-notification-state": "^2.0.0"
  },
  "engines": {
    "node": "24.x"
  },
  "reactDoctor": {
    "ignore": {
      "files": [
        "electron-builder.config.ts",
        "scripts/generate-changelog.mjs",
        "scripts/generate-test-data.ts"
      ]
    }
  }
}
